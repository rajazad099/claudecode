<section class="section section--tight">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}<p class="label label--muted" style="margin-bottom:16px">{{ section.settings.heading }}</p>{%- endif -%}
    <div class="stats">
      {%- for block in section.blocks -%}
        <div class="stat" {{ block.shopify_attributes }} data-reveal>
          <span class="stat__num">{{ block.settings.number }}</span>
          <span class="label label--muted">{{ block.settings.caption }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Numbers",
  "settings": [ { "type": "text", "id": "heading", "label": "Label" } ],
  "blocks": [
    {
      "type": "stat", "name": "Number",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "2022" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Founded" }
      ]
    }
  ],
  "presets": [ { "name": "Numbers" } ]
}
{% endschema %}
