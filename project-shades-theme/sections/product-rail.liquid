{%- liquid
  assign s = section.settings
  if s.products != blank
    assign items = s.products
  else
    assign items = s.collection.products
  endif
-%}
<section class="section{% if s.tone == 'raise' %} section--raise{% endif %}">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        {%- if s.label != blank -%}<span class="label label--muted">{{ s.label }}</span>{%- endif -%}
        <h2 class="h2">{{ s.heading }}</h2>
      </div>
      {%- if s.link_label != blank -%}<a class="link-arrow" href="{{ s.link | default: s.collection.url }}">{{ s.link_label }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    </div>
    {%- if s.layout == 'grid' -%}
      <div class="grid grid--4">
        {%- for product in items limit: s.limit -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
    {%- else -%}
      <div class="rail">
        {%- for product in items limit: s.limit -%}{% render 'product-card', product: product, sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 38vw, 68vw' %}{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product rail",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Most loved" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "product_list", "id": "products", "label": "Pick products", "limit": 16, "info": "Overrides the collection." },
    { "type": "collection", "id": "collection", "label": "Or a collection" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "rail", "label": "Swipe rail" }, { "value": "grid", "label": "Grid" } ], "default": "rail" },
    { "type": "select", "id": "tone", "label": "Background", "options": [ { "value": "paper", "label": "Paper" }, { "value": "raise", "label": "Light" } ], "default": "paper" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [ { "name": "Product rail" } ]
}
{% endschema %}
