<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        {%- if section.settings.label != blank -%}<span class="label label--muted">{{ section.settings.label }}</span>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="vibes">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="vibe" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }} data-reveal>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 50vw', widths: '400, 600, 900', alt: '' }}
          {%- elsif c.featured_image -%}
            {{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 50vw', alt: '' }}
          {%- endif -%}
          <span class="vibe__text">
            <span class="label">[ {{ block.settings.tag | default: c.title }} ]</span>
            <span class="vibe__name">{{ block.settings.title | default: c.title }}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by vibe",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Shop by vibe" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who are you today?" }
  ],
  "blocks": [
    {
      "type": "vibe", "name": "Vibe",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Vibe name" },
        { "type": "text", "id": "tag", "label": "Shape tag" }
      ]
    }
  ],
  "presets": [ { "name": "Shop by vibe" } ]
}
{% endschema %}
