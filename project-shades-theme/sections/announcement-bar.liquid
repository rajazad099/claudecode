{%- if section.blocks.size > 0 -%}
<div class="announce" data-announce role="region" aria-label="Announcements">
  <div class="announce__track">
    {%- for block in section.blocks -%}
      <div class="announce__item" {{ block.shopify_attributes }}>
        <span class="announce__dot" aria-hidden="true"></span>
        {%- if block.settings.link != blank -%}
          <a class="label" href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          <span class="label">{{ block.settings.text }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Buy 2, get 10% off · Buy 3, get 15% off" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Announcement bar", "blocks": [ { "type": "announcement" } ] } ]
}
{% endschema %}
