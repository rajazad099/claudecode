<section class="section{% if section.settings.tight %} section--tight{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="section-head" data-reveal>
        <div>
          <span class="label label--muted">{{ section.settings.label }}</span>
          <h2 class="h2">{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}
    <div class="promise">
      {%- for block in section.blocks -%}
        <div class="promise__item" {{ block.shopify_attributes }} data-reveal>
          {% render 'icon', name: block.settings.icon %}
          <span class="promise__title">{{ block.settings.title }}</span>
          <span class="promise__text">{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promises",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "The fine print, made big" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good taste, zero risk." },
    { "type": "checkbox", "id": "tight", "label": "Less padding", "default": false }
  ],
  "blocks": [
    {
      "type": "promise", "name": "Promise",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "sun", "options": [
          { "value": "sun", "label": "Sun" }, { "value": "cash", "label": "Cash" }, { "value": "bolt", "label": "Bolt" },
          { "value": "return", "label": "Return" }, { "value": "shield", "label": "Shield" }, { "value": "feather", "label": "Feather" },
          { "value": "truck", "label": "Truck" }, { "value": "box", "label": "Box" }, { "value": "whatsapp", "label": "WhatsApp" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "UV400 on every pair" },
        { "type": "text", "id": "text", "label": "Text", "default": "Blocks 100% of UVA and UVB rays." }
      ]
    }
  ],
  "presets": [ { "name": "Promises" } ]
}
{% endschema %}
