{%- if section.blocks.size > 0 -%}
<section class="press" style="--speed: {{ section.settings.speed }}s">
  <div class="press__inner">
    <span class="press__label label label--muted">{{ section.settings.label }}</span>
    <div class="press__viewport">
      <div class="press__track">
        {%- for pass in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              {%- capture logo -%}{{ block.settings.image | image_url: height: 80 | image_tag: loading: 'lazy', alt: block.settings.name, height: 28 }}{%- endcapture -%}
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener"{% if pass == 2 %} aria-hidden="true" tabindex="-1"{% endif %}>{{ logo }}</a>{%- else -%}<span{% if pass == 2 %} aria-hidden="true"{% endif %}>{{ logo }}</span>{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "As seen in",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "As seen in" },
    { "type": "range", "id": "speed", "label": "Scroll time", "min": 10, "max": 60, "step": 2, "unit": "s", "default": 28 }
  ],
  "blocks": [
    {
      "type": "logo", "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Publication name" },
        { "type": "url", "id": "link", "label": "Link to the feature" }
      ]
    }
  ],
  "presets": [ { "name": "As seen in" } ]
}
{% endschema %}
