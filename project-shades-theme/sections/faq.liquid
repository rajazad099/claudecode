<section class="section" id="faq">
  <div class="wrap faq">
    <div style="display:grid;gap:14px;align-content:start" data-reveal>
      <span class="label label--muted">{{ section.settings.label }}</span>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if settings.whatsapp_number != blank -%}
        <p class="lede">Still stuck? <a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener" style="text-decoration:underline;text-underline-offset:3px">WhatsApp us</a> — a real human replies.</p>
      {%- endif -%}
    </div>
    <div class="acc">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="acc__icon"></span></summary>
          <div class="acc__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Questions, answered" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you ask." }
  ],
  "blocks": [
    {
      "type": "question", "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Are these sunglasses UV protected?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. Every pair offers UV400 protection.</p>" }
      ]
    }
  ],
  "presets": [ { "name": "FAQ" } ]
}
{% endschema %}
