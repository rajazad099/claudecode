<div class="wrap" style="min-height:100svh;display:grid;align-content:center;gap:20px;padding-block:48px">
  <span class="label label--muted">{{ shop.name }}</span>
  <h1 class="display" style="max-width:10ch">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p class="lede">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}<p class="notice notice--error">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div style="display:flex;gap:8px;max-width:420px">
      <label class="visually-hidden" for="Password">Password</label>
      <input id="Password" type="password" name="password" placeholder="Password" style="flex:1;min-width:0;height:52px;border:1px solid var(--line);background:var(--raise);padding:0 14px;font-size:16px">
      <button class="btn" type="submit">Enter</button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Something new is coming." } ]
}
{% endschema %}
