<div class="wrap coll-head">
  <span class="label label--muted">Journal</span>
  <h1 class="h1">{{ blog.title }}</h1>
</div>
<div class="wrap" style="padding-bottom:64px">
  {%- paginate blog.articles by 12 -%}
    <div class="grid">
      {%- for article in blog.articles -%}
        <a class="card" href="{{ article.url }}">
          <span class="card__media" style="aspect-ratio:4/3">
            {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title, style: 'object-fit:cover;padding:0;mix-blend-mode:normal' }}{%- endif -%}
          </span>
          <span class="card__body">
            <span class="label label--muted">{{ article.published_at | date: '%d %b %Y' }}</span>
            <span class="card__model" style="font-size:20px;line-height:1.1">{{ article.title }}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pages">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="is-current">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
