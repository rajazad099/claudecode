{%- comment -%} Uses Shopify's recommendation engine; rendered via ?section_id after load so it never blocks the page. {%- endcomment -%}
<section class="section" data-recs data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}">
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="label label--muted">{{ section.settings.label }}</span>
          <h2 class="h2">{{ section.settings.heading }}</h2>
        </div>
      </div>
      <div class="rail">
        {%- for p in recommendations.products -%}{% render 'product-card', product: p, sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 38vw, 68vw' %}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>
<script>
  (() => {
    const el = document.querySelector('[data-recs]:not([data-loaded])');
    if (!el || el.children.length) return;
    el.dataset.loaded = '1';
    const load = () => fetch(el.dataset.url).then((r) => r.text()).then((html) => {
      const fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-recs]');
      if (fresh && fresh.innerHTML.trim()) el.innerHTML = fresh.innerHTML; else el.remove();
    }).catch(() => el.remove());
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); load(); } }, { rootMargin: '600px 0px' });
      io.observe(el);
    } else { load(); }
  })();
</script>

{% schema %}
{
  "name": "Recommendations",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Same energy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might also like" },
    { "type": "select", "id": "intent", "label": "Type", "options": [ { "value": "related", "label": "Related" }, { "value": "complementary", "label": "Complementary" } ], "default": "related" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 10, "step": 1, "default": 8 }
  ]
}
{% endschema %}
