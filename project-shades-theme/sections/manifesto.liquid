{%- assign s = section.settings -%}
<section class="section{% if s.tone == 'ink' %} section--ink{% elsif s.tone == 'raise' %} section--raise{% endif %}">
  <div class="wrap manifesto">
    <div style="display:grid;gap:14px" data-reveal>
      {%- if s.label != blank -%}<span class="label{% if s.tone == 'ink' %}{% else %} label--muted{% endif %}"{% if s.tone == 'ink' %} style="color:var(--sun)"{% endif %}>{{ s.label }}</span>{%- endif -%}
      <h2 class="h1">{{ s.heading }}</h2>
    </div>
    <div style="display:grid;gap:20px" data-reveal>
      <div class="manifesto__body rte">{{ s.text }}</div>
      {%- if s.btn_label != blank -%}<div><a class="link-arrow" href="{{ s.btn_link }}">{{ s.btn_label }} {% render 'icon', name: 'arrow' %}</a></div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Manifesto",
  "settings": [
    { "type": "select", "id": "tone", "label": "Background", "options": [ { "value": "paper", "label": "Paper" }, { "value": "raise", "label": "Light" }, { "value": "ink", "label": "Ink" } ], "default": "paper" },
    { "type": "text", "id": "label", "label": "Label", "default": "Why Project Shades" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "No loud logos. Just good taste." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We make the frames we couldn't find: a little disruptive, never ordinary, priced like they should be.</p>" },
    { "type": "text", "id": "btn_label", "label": "Link label", "default": "Our story" },
    { "type": "url", "id": "btn_link", "label": "Link" }
  ],
  "presets": [ { "name": "Manifesto" } ]
}
{% endschema %}
