        "q3": {
          "type": "question",
          "settings": {
            "question": "How long will my order take to arrive?",
            "answer": "<p>3–7 working days in India. We ship all orders next day, except Sundays. Tentative delivery timeline once shipped: Mumbai &amp; Pune 2 days, Delhi &amp; Ahmedabad 3–4 days, Bangalore &amp; Hyderabad 4–5 days.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Will it suit my face?",
            "answer": "<p>Every product page shows which face sizes a frame fits, plus a 30-second fit check you can do with any debit card. Still unsure? WhatsApp us a selfie on +91 7558544365 and we'll tell you honestly.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>Once shipped, you'll receive a tracking link via email and WhatsApp. You can also <a href=\"https://projectshades.shiprocket.co/tracking\">track it here</a> anytime.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Can I change my order after placing it?",
            "answer": "<p>Only if it hasn't shipped. We move fast — like your new shades will. Reach out on support@projectshades.com, WhatsApp +91 7558544365 or DM @project.shades.</p>"
          }
        },
        "q7": {
          "type": "question",
