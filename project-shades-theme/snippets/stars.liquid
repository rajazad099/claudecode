{%- comment -%} Renders a star meter. Accepts rating (0-5) and count. {%- endcomment -%}
{%- liquid
  assign r = rating | default: 0 | times: 1.0
  assign pct = r | divided_by: 5.0 | times: 100 | round: 1
-%}
<span class="stars">
  <span class="stars__icons" role="img" aria-label="Rated {{ r | round: 1 }} out of 5"><span class="stars__fill" style="width: {{ pct }}%"></span></span>
  {%- if count -%}<span>{{ r | round: 1 }} <span aria-hidden="true">·</span> {{ count }} {% if count == 1 %}review{% else %}reviews{% endif %}</span>{%- endif -%}
</span>
