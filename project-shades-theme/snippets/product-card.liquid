{%- comment -%}
  Product card. Accepts product, optional lazy (default true), optional sizes.
  First image is the packshot (blended into the tile), second is the on-face shot on hover.
{%- endcomment -%}
{%- liquid
  assign lazy = lazy | default: true
  assign sizes = sizes | default: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign img1 = product.featured_media
  assign img2 = product.media[1]
  assign variant = product.selected_or_first_available_variant
  assign rating = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count.value
  assign quick = false
  if product.has_only_default_variant and product.available
    assign quick = true
  endif
-%}
<article class="card">
  <a class="card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}" tabindex="-1">
    {%- if img1 -%}
      {{ img1.preview_image | image_url: width: 720 | image_tag: loading: lazy, sizes: sizes, widths: '360, 540, 720', alt: product.title }}
      {%- if img2 and img2.media_type == 'image' -%}
        {{ img2 | image_url: width: 720 | image_tag: loading: 'lazy', sizes: sizes, widths: '360, 540, 720', alt: '', class: 'card__alt' }}
      {%- endif -%}
    {%- endif -%}
  </a>
  <div class="card__badges">
    {%- if product.available == false -%}
      <span class="badge badge--ink">Sold out</span>
    {%- else -%}
      {%- for tag in product.tags -%}
        {%- if tag contains 'badge:' -%}<span class="badge badge--sun">{{ tag | remove: 'badge:' | strip }}</span>{%- endif -%}
      {%- endfor -%}
      {%- if product.compare_at_price > product.price -%}
        {%- assign off = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
        <span class="badge">−{{ off }}%</span>
      {%- endif -%}
    {%- endif -%}
  </div>
  {%- if quick -%}
    <button class="card__add" type="button" data-quick-add="{{ variant.id }}" aria-label="Add {{ product.title | escape }} to bag">{% render 'icon', name: 'plus' %}</button>
  {%- endif -%}
  <a class="card__body" href="{{ product.url }}">
    {%- capture col -%}{% render 'ps-name', title: product.title, part: 'colour' %}{%- endcapture -%}
    {%- if col != blank -%}<span class="label label--muted">[ {{ col }} ]</span>{%- endif -%}
    <span class="card__model">{% render 'ps-name', title: product.title, part: 'model' %}</span>
    <span class="card__sub">{% render 'ps-name', title: product.title, part: 'style' %}</span>
    <span class="card__meta">
      {% render 'price', price: product.price, compare: product.compare_at_price %}
      {%- if rating_count > 0 -%}{% render 'stars', rating: rating %}{%- endif -%}
    </span>
  </a>
</article>
