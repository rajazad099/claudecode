{%- comment -%}
  ENCORE WORLDWIDE — hero
  EW-001 // black, white, chrome. blue is rationed to five elements.

  Built mobile-first. The still image is the LCP element; video, if set, fades
  in over it once it can play and is skipped entirely on reduced-motion,
  save-data and 2G.

  Headline: press Enter for a new line. Wrap a whole line in *asterisks* to
  give it the chrome finish.
{%- endcomment -%}

{{ 'encore-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'encore-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign heading_tag = s.heading_tag | default: 'h1'

  assign img_m = s.image_mobile | default: s.image_desktop
  assign img_d = s.image_desktop | default: s.image_mobile
  assign poster = img_m | default: img_d

  assign img_alt = img_m.alt | default: img_d.alt | default: shop.name

  case s.height
    when 'tall'
      assign min_h = '100svh'
      assign min_h_fb = '100vh'
    when 'medium'
      assign min_h = '86svh'
      assign min_h_fb = '86vh'
    else
      assign min_h = '72svh'
      assign min_h_fb = '72vh'
  endcase
-%}

{%- if s.load_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Mono:wght@400;700&display=swap"
  >
{%- endif -%}

{%- comment -%} Pick one mp4 per breakpoint out of Shopify's rendition list. {%- endcomment -%}
{%- liquid
  for src in s.video_mobile.sources
    if src.format == 'mp4'
      assign video_m = src.url
      if src.height >= 720
        break
      endif
    endif
  endfor

  for src in s.video_desktop.sources
    if src.format == 'mp4'
      assign video_d = src.url
    endif
  endfor
-%}

<style>
  #EncoreHero--{{ section.id }} {
    --ew-min-h: {{ min_h }};
    --ew-min-h-fb: {{ min_h_fb }};
    --ew-scrim: {{ s.scrim | divided_by: 100.0 }};
    --ew-title-scale: {{ s.title_scale | divided_by: 100.0 }};
    --ew-ticker-duration: {{ s.ticker_speed }}s;
    --ew-focal-x-m: {{ s.focal_x_mobile }}%;
    --ew-focal-y-m: {{ s.focal_y_mobile }}%;
    --ew-focal-x-d: {{ s.focal_x_desktop }}%;
    --ew-focal-y-d: {{ s.focal_y_desktop }}%;
  }
</style>

<section id="EncoreHero--{{ section.id }}" class="ew-hero ew-hero--{{ s.content_position }}">
  {%- if s.show_tape -%}
    <div class="ew-hero__tape" aria-hidden="true"></div>
  {%- endif -%}

  <div class="ew-hero__media">
    <div class="ew-hero__media-inner">
      {%- if img_m != blank or img_d != blank -%}
        {%- capture srcset_m -%}
          {%- for w in (1..5) -%}
            {%- assign width = w | times: 200 | plus: 200 -%}
            {%- if img_m.width >= width -%}{{ img_m | image_url: width: width }} {{ width }}w, {% endif %}
          {%- endfor -%}
          {{ img_m | image_url: width: img_m.width }} {{ img_m.width }}w
        {%- endcapture -%}
        {%- capture srcset_d -%}
          {%- for w in (1..5) -%}
            {%- assign width = w | times: 400 | plus: 800 -%}
            {%- if img_d.width >= width -%}{{ img_d | image_url: width: width }} {{ width }}w, {% endif %}
          {%- endfor -%}
          {{ img_d | image_url: width: img_d.width }} {{ img_d.width }}w
        {%- endcapture -%}
        <picture>
          <source media="(min-width: 750px)" srcset="{{ srcset_d }}" sizes="100vw">
          <img
            src="{{ img_m | image_url: width: 800 }}"
            srcset="{{ srcset_m }}"
            sizes="100vw"
            width="{{ img_m.width }}"
            height="{{ img_m.height }}"
            alt="{{ img_alt | escape }}"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
        </picture>
      {%- endif -%}

      {%- if video_m != blank or video_d != blank -%}
        <video
          class="ew-hero__video"
          {% if video_m != blank %}data-src-mobile="{{ video_m }}"{% endif %}
          {% if video_d != blank %}data-src-desktop="{{ video_d }}"{% endif %}
          {% if poster != blank %}poster="{{ poster | image_url: width: 1200 }}"{% endif %}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          tabindex="-1"
        ></video>
      {%- endif -%}
    </div>
  </div>

  <div class="ew-hero__scrim" aria-hidden="true"></div>
  {%- if s.show_grain -%}
    <div class="ew-hero__grain" aria-hidden="true"></div>
  {%- endif -%}
  {%- if s.show_scan -%}
    <div class="ew-hero__scan" aria-hidden="true"></div>
  {%- endif -%}

  <div class="ew-hero__rail">
    <span>{{ s.rail_left | escape }}</span>
    <span class="ew-hero__rail-mid">{{ s.rail_middle | escape }}</span>
    <span class="ew-hero__status">
      <span class="ew-hero__dot" aria-hidden="true"></span>
      {{ s.rail_status | escape }}
    </span>
  </div>

  <div class="ew-hero__stage">
    {%- if s.show_orbit -%}
      <div class="ew-hero__orbit" aria-hidden="true">
        <div class="ew-hero__orbit-ring"></div>
        <div class="ew-hero__orbit-dot"></div>
      </div>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <{{ heading_tag }} class="ew-hero__title">
        {%- assign lines = s.heading | newline_to_br | split: '<br />' -%}
        {%- assign i = 0 -%}
        {%- for line in lines -%}
          {%- assign text = line | strip -%}
          {%- if text == blank -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign chrome = false -%}
          {%- if text contains '*' -%}
            {%- assign chrome = true -%}
            {%- assign text = text | remove: '*' -%}
          {%- endif -%}
          <span class="ew-hero__line"><span
              class="ew-hero__line-in{% if chrome %} ew-hero__line-in--chrome{% endif %}"
              style="--i: {{ i }}"
              data-text="{{ text | escape }}"
            >{{ text | escape }}</span></span>
          {%- assign i = i | plus: 1 -%}
        {%- endfor -%}
      </{{ heading_tag }}>
    {%- endif -%}

    {%- if s.support != blank -%}
      <div class="ew-hero__support">{{ s.support }}</div>
    {%- endif -%}

    {%- if s.cta_label != blank -%}
      <a class="ew-hero__cta" href="{{ s.cta_link | default: '#' }}">
        {{ s.cta_label | escape }}
        <svg width="16" height="8" viewBox="0 0 16 8" fill="none" aria-hidden="true">
          <path d="M0 4h14M11 1l3 3-3 3" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      </a>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="ew-hero__chips">
      {%- for block in section.blocks -%}
        {%- if block.settings.label != blank -%}
          <li class="ew-hero__chip" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if s.show_cue -%}
    <div class="ew-hero__cue" aria-hidden="true">
      <span>{{ s.cue_label | escape }}</span>
      <svg width="9" height="16" viewBox="0 0 9 16" fill="none">
        <path d="M4.5 0v14M1 11l3.5 3.5L8 11" stroke="currentColor" stroke-width="1.2"/>
      </svg>
    </div>
  {%- endif -%}

  {%- if s.show_ticker and s.ticker != blank -%}
    {%- assign ticker_items = s.ticker | split: ',' -%}
    <div class="ew-hero__ticker">
      {%- for pass in (1..2) -%}
        <div class="ew-hero__ticker-track" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
          {%- for item in ticker_items -%}
            <span class="ew-hero__ticker-item">{{ item | strip | escape }}</span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Encore hero",
  "tag": "div",
  "class": "encore-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "paragraph",
      "content": "Every image is forced to black and white. Set a separate mobile crop — 99% of visitors are on a phone and a landscape photo will not survive a portrait viewport."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image — mobile (portrait)"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image — desktop (landscape)"
    },
    {
      "type": "range",
      "id": "focal_x_mobile",
      "label": "Mobile focal point — horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_y_mobile",
      "label": "Mobile focal point — vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "focal_x_desktop",
      "label": "Desktop focal point — horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_y_desktop",
      "label": "Desktop focal point — vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Video — mobile (portrait)",
      "info": "Optional. Fades in over the image. Skipped on reduced-motion, data saver and 2G."
    },
    {
      "type": "video",
      "id": "video_desktop",
      "label": "Video — desktop (landscape)"
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Headline",
      "info": "Enter for a new line. Wrap a whole line in *asterisks* for the chrome finish.",
      "default": "Jewellery\nfrom the\n*future.*"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "H1 when this is the first section on the page.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "title_scale",
      "label": "Headline size",
      "min": 70,
      "max": 130,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "richtext",
      "id": "support",
      "label": "Support line",
      "default": "<p>small runs, made because we wanted them. shipped worldwide. no restocks.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Discover collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "medium", "label": "Medium" },
        { "value": "tall", "label": "Full screen" }
      ],
      "default": "tall"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "bottom", "label": "Bottom" },
        { "value": "center", "label": "Centre" },
        { "value": "top", "label": "Top" }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "scrim",
      "label": "Darkening over the photo",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 72
    },
    {
      "type": "header",
      "content": "Telemetry rail"
    },
    {
      "type": "text",
      "id": "rail_left",
      "label": "Left",
      "default": "EW-001 // DROP 001"
    },
    {
      "type": "text",
      "id": "rail_middle",
      "label": "Middle",
      "info": "Desktop only.",
      "default": "LAT 19.99 / LON 73.78"
    },
    {
      "type": "text",
      "id": "rail_status",
      "label": "Status",
      "default": "Live"
    },
    {
      "type": "header",
      "content": "Ticker"
    },
    {
      "type": "checkbox",
      "id": "show_ticker",
      "label": "Show ticker",
      "default": true
    },
    {
      "type": "text",
      "id": "ticker",
      "label": "Ticker items",
      "info": "Separate with commas.",
      "default": "Priority — cool shit, 50 made, 0 restocks, 0 ads ever, shipped worldwide obviously"
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "label": "Ticker duration",
      "min": 20,
      "max": 90,
      "step": 2,
      "unit": "s",
      "default": 38
    },
    {
      "type": "header",
      "content": "Motion and grit"
    },
    {
      "type": "checkbox",
      "id": "show_orbit",
      "label": "Orbit",
      "info": "One lap around everything.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scan",
      "label": "Scan line",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Film grain",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cue",
      "label": "Scroll cue",
      "default": true
    },
    {
      "type": "text",
      "id": "cue_label",
      "label": "Scroll cue label",
      "default": "Scroll"
    },
    {
      "type": "checkbox",
      "id": "show_tape",
      "label": "Hazard tape",
      "info": "Edges and warnings only. Off by default.",
      "default": false
    },
    {
      "type": "header",
      "content": "Type"
    },
    {
      "type": "checkbox",
      "id": "load_fonts",
      "label": "Load Anton and Space Mono",
      "info": "Turn off if the theme already self-hosts them. Falls back to condensed system faces.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Necklaces"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Encore hero",
      "blocks": [
        { "type": "category", "settings": { "label": "Necklaces" } },
        { "type": "category", "settings": { "label": "Ear cuffs" } },
        { "type": "category", "settings": { "label": "Rings" } },
        { "type": "category", "settings": { "label": "Bracelets" } },
        { "type": "category", "settings": { "label": "Earrings" } },
        { "type": "category", "settings": { "label": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
