{%- comment -%}
  ENCORE WORLDWIDE — the storefront hero
  EW-002 // the whole shop is drawn in CSS and SVG. no photography, no uploads.

  Blue is spent almost entirely on one object — the display table. The rest of
  the room is ink, paper and chrome.
{%- endcomment -%}

{{ 'encore-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'encore-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign chrome = 'url(#ewChrome-' | append: uid | append: ')'

  case s.height
    when 'short'
      assign min_h = '78svh'
      assign min_h_fb = '78vh'
    when 'medium'
      assign min_h = '90svh'
      assign min_h_fb = '90vh'
    else
      assign min_h = '100svh'
      assign min_h_fb = '100vh'
  endcase

  case s.sign_font
    when 'playfair'
      assign sign_family = 'Playfair Display'
      assign sign_query = 'family=Playfair+Display:wght@500;600'
    when 'libre'
      assign sign_family = 'Libre Baskerville'
      assign sign_query = 'family=Libre+Baskerville:wght@400;700'
    when 'prata'
      assign sign_family = 'Prata'
      assign sign_query = 'family=Prata'
    else
      assign sign_family = ''
  endcase
-%}

{%- if s.load_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?{% if sign_query %}{{ sign_query }}&{% endif %}family=Space+Mono:wght@400;700&display=swap"
  >
{%- endif -%}

<style>
  #EncoreHero--{{ uid }} {
    --ew-min-h: {{ min_h }};
    --ew-min-h-fb: {{ min_h_fb }};
    --ew-ticker-duration: {{ s.ticker_speed }}s;
    {%- if sign_family != blank %}
    --ew-serif-font: "{{ sign_family }}";
    {%- endif %}
  }
</style>

{%- comment -%} One sprite for the whole section: the chrome, and the pieces. {%- endcomment -%}
<svg class="ew-hero__defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="ewChrome-{{ uid }}" x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset="0.26" stop-color="#dcdcdc"/>
      <stop offset="0.5" stop-color="#6d6d6d"/>
      <stop offset="0.7" stop-color="#f0f0f0"/>
      <stop offset="1" stop-color="#9b9b9b"/>
    </linearGradient>

    <symbol id="ewp-necklace-{{ uid }}" viewBox="0 0 48 48">
      <path d="M11 11C11 32 37 32 37 11" fill="none" stroke="{{ chrome }}" stroke-width="2.4" stroke-linecap="round"/>
      <path d="M24 26.5l4.2 4.6-4.2 5.4-4.2-5.4z" fill="{{ chrome }}"/>
    </symbol>

    <symbol id="ewp-ear-cuff-{{ uid }}" viewBox="0 0 48 48">
      <path d="M31 13a12.5 12.5 0 100 22" fill="none" stroke="{{ chrome }}" stroke-width="3.2" stroke-linecap="round"/>
      <circle cx="31.5" cy="12.5" r="2.6" fill="{{ chrome }}"/>
      <circle cx="31.5" cy="35.5" r="2.6" fill="{{ chrome }}"/>
    </symbol>

    <symbol id="ewp-ring-{{ uid }}" viewBox="0 0 48 48">
      <circle cx="24" cy="29" r="10" fill="none" stroke="{{ chrome }}" stroke-width="2.9"/>
      <path d="M24 10l4.4 5.2-4.4 5.2-4.4-5.2z" fill="{{ chrome }}"/>
      <path d="M19.6 15.2h8.8" stroke="#ffffff" stroke-opacity=".55" stroke-width="1"/>
    </symbol>

    <symbol id="ewp-bracelet-{{ uid }}" viewBox="0 0 48 48">
      <ellipse cx="24" cy="24" rx="14" ry="9.5" fill="none" stroke="{{ chrome }}" stroke-width="3.6"/>
      <ellipse cx="24" cy="24" rx="14" ry="9.5" fill="none" stroke="#ffffff" stroke-opacity=".35" stroke-width="0.9"/>
    </symbol>

    <symbol id="ewp-earring-{{ uid }}" viewBox="0 0 48 48">
      <path d="M20 14a4.6 4.6 0 118.4 2.6" fill="none" stroke="{{ chrome }}" stroke-width="2"/>
      <path d="M24 20c7.2 8.4 7.2 16 0 18-7.2-2-7.2-9.6 0-18z" fill="{{ chrome }}"/>
    </symbol>

    <symbol id="ewp-charm-{{ uid }}" viewBox="0 0 48 48">
      <rect x="13" y="21.5" width="22" height="5.5" rx="2.75" fill="{{ chrome }}"/>
      <circle cx="12" cy="24.2" r="3.6" fill="none" stroke="{{ chrome }}" stroke-width="2.2"/>
      <circle cx="36" cy="24.2" r="3.6" fill="none" stroke="{{ chrome }}" stroke-width="2.2"/>
    </symbol>
  </defs>
</svg>

<section id="EncoreHero--{{ uid }}" class="ew-hero">
  <div class="ew-hero__hud">
    <span class="ew-hero__rec">{{ s.hud_left | escape }}</span>
    <span class="ew-hero__hud-mid">{{ s.hud_middle | escape }}</span>
    <span class="ew-hero__clock" data-ew-clock>--:--:--</span>
  </div>

  {%- if s.sign_text != blank -%}
    <div class="ew-hero__fascia">
      <span class="ew-fascia__word">{{ s.sign_text | escape }}</span>
    </div>
  {%- endif -%}

  <div class="ew-store">
    <div class="ew-store__room">
      <div class="ew-store__ceiling"></div>
      <div class="ew-store__wall-l"></div>
      <div class="ew-store__wall-r"></div>
      <div class="ew-store__floor"></div>

      <div class="ew-store__wall">
        {%- if section.blocks.size > 0 -%}
          <ul class="ew-store__niches">
            {%- for block in section.blocks -%}
              <li class="ew-niche" style="--n: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <svg class="ew-niche__piece" viewBox="0 0 48 48" aria-hidden="true">
                  <use href="#ewp-{{ block.settings.piece }}-{{ uid }}"/>
                </svg>
                <span class="ew-niche__glint" style="--n: {{ forloop.index0 }}"></span>
                {%- if block.settings.label != blank -%}
                  <span class="ew-niche__label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Track lighting. One tube is on its way out. {%- endcomment -%}
      {%- assign lamp_x = '18,34,50,66,82' | split: ',' -%}
      {%- for x in lamp_x -%}
        {%- assign faulty = false -%}
        {%- if s.show_flicker and forloop.index == 4 -%}
          {%- assign faulty = true -%}
        {%- endif -%}
        <span
          class="ew-lamp{% if faulty %} ew-lamp--faulty{% endif %}"
          style="--x: {{ x }}%; --n: {{ forloop.index0 }}"
        ></span>
        <span
          class="ew-cone{% if faulty %} ew-cone--faulty{% endif %}"
          style="--x: {{ x }}%; --n: {{ forloop.index0 }}"
        ></span>
      {%- endfor -%}

      {%- comment -%}
        The vitrine is always rendered as the anchor so the globe stands in the
        same place whether or not the table itself is switched on.
      {%- endcomment -%}
      {%- if s.show_table -%}
        <div class="ew-store__caustic"></div>
        <div class="ew-store__pool"></div>
      {%- endif -%}

      <div class="ew-store__table">
        {%- if s.show_table -%}
          <div class="ew-table__top"></div>
          <div class="ew-table__front">
            {%- if s.table_plate != blank -%}
              <span class="ew-table__plate">{{ s.table_plate | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.show_globe -%}
          <div class="ew-store__globe">
            {%- if s.globe_image != blank -%}
              {{ s.globe_image | image_url: width: 300 | image_tag: alt: '', loading: 'lazy' }}
            {%- else -%}
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <defs>
                  <clipPath id="ewGlobeClip-{{ uid }}"><circle cx="50" cy="50" r="27"/></clipPath>
                  <radialGradient id="ewGlobeBody-{{ uid }}" cx="34%" cy="26%" r="80%">
                    <stop offset="0" stop-color="#3a3a3a"/>
                    <stop offset="0.55" stop-color="#141414"/>
                    <stop offset="1" stop-color="#050505"/>
                  </radialGradient>
                  <radialGradient id="ewGlobeShade-{{ uid }}" cx="36%" cy="28%" r="82%">
                    <stop offset="0.5" stop-color="#000000" stop-opacity="0"/>
                    <stop offset="1" stop-color="#000000" stop-opacity="0.72"/>
                  </radialGradient>
                </defs>

                {%- comment -%} The orbit, echoing the swoosh in the wordmark. {%- endcomment -%}
                <ellipse cx="50" cy="50" rx="45" ry="15" fill="none" stroke="#ffffff" stroke-opacity="0.3"
                         stroke-width="1" transform="rotate(-19 50 50)"/>

                <circle cx="50" cy="50" r="27" fill="url(#ewGlobeBody-{{ uid }})"/>

                <g clip-path="url(#ewGlobeClip-{{ uid }})">
                  <g class="ew-globe__spin" fill="#ededed">
                    {%- comment -%} Landmasses, drawn twice so the spin never seams. {%- endcomment -%}
                    {%- for pass in (1..2) -%}
                      {%- assign dx = forloop.index0 | times: 54 -%}
                      <g transform="translate({{ dx }} 0)">
                        <path d="M28 34c4-3 9-2 11 1s-2 6-6 7-7 2-9-1 1-6 4-7z"/>
                        <path d="M33 52c3-1 6 1 6 5s-2 8-5 8-6-4-5-8 1-4 4-5z"/>
                        <path d="M46 31c5-2 10-1 12 2s-2 5-5 6-5 3-8 2-3-8 1-10z"/>
                        <path d="M52 50c4-2 8 1 8 4s-3 6-7 6-6-3-6-6 1-3 5-4z"/>
                        <path d="M62 40c3-1 6 1 6 3s-3 4-6 4-5-2-4-4 2-3 4-3z"/>
                        <path d="M27 62c2-1 5 0 5 2s-2 3-4 3-4-1-3-3z"/>
                      </g>
                    {%- endfor -%}
                  </g>
                  <circle cx="50" cy="50" r="27" fill="url(#ewGlobeShade-{{ uid }})"/>
                </g>

                <ellipse cx="50" cy="50" rx="27" ry="9" fill="none" stroke="#ffffff" stroke-opacity="0.14"/>
                <circle cx="50" cy="50" r="27" fill="none" stroke="#ffffff" stroke-opacity="0.5"/>
                <path d="M31 34a27 27 0 0 1 27-10" fill="none" stroke="#ffffff" stroke-opacity="0.7"
                      stroke-width="1.4" stroke-linecap="round"/>
              </svg>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if s.show_dust -%}
        <div class="ew-store__dust" aria-hidden="true">
          {%- assign motes = '22:74:19,31:58:23,44:80:17,52:62:26,61:76:21,69:55:24,78:72:18,37:68:28' | split: ',' -%}
          {%- for mote in motes -%}
            {%- assign m = mote | split: ':' -%}
            <span style="--x: {{ m[0] }}%; --y: {{ m[1] }}%; --d: {{ m[2] }}s; --n: {{ forloop.index0 }}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if s.show_mullions -%}
      <div class="ew-store__mullions" aria-hidden="true">
        <span style="--x: 33.33%"></span>
        <span style="--x: 66.66%"></span>
      </div>
    {%- endif -%}

    {%- if s.show_sheen -%}
      <div class="ew-store__sheen" aria-hidden="true"></div>
    {%- endif -%}
    <div class="ew-store__vignette" aria-hidden="true"></div>
    {%- if s.show_grain -%}
      <div class="ew-store__grain" aria-hidden="true"></div>
    {%- endif -%}

    <div class="ew-store__copy">
      {%- if s.decal != blank -%}
        <div class="ew-store__decal">{{ s.decal }}</div>
      {%- endif -%}
      {%- if s.cta_label != blank -%}
        <a class="ew-hero__cta" href="{{ s.cta_link | default: '#' }}">
          {{ s.cta_label | escape }}
          <svg width="16" height="8" viewBox="0 0 16 8" fill="none" aria-hidden="true">
            <path d="M0 4h14M11 1l3 3-3 3" stroke="currentColor" stroke-width="1.4"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="ew-hero__chips">
      {%- for block in section.blocks -%}
        {%- if block.settings.label != blank -%}
          <li class="ew-hero__chip">
            <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.label | escape }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if s.show_ticker and s.ticker != blank -%}
    {%- assign ticker_items = s.ticker | split: ',' -%}
    <div class="ew-hero__ticker">
      {%- for pass in (1..2) -%}
        <div class="ew-hero__ticker-track" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
          {%- for item in ticker_items -%}
            <span class="ew-hero__ticker-item">{{ item | strip | escape }}</span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Encore storefront hero",
  "tag": "div",
  "class": "encore-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "The sign"
    },
    {
      "type": "text",
      "id": "sign_text",
      "label": "Sign",
      "default": "Encore Worldwide"
    },
    {
      "type": "select",
      "id": "sign_font",
      "label": "Sign typeface",
      "info": "A high-contrast serif, illuminated — the shopfront convention.",
      "options": [
        { "value": "playfair", "label": "Playfair Display" },
        { "value": "prata", "label": "Prata" },
        { "value": "libre", "label": "Libre Baskerville" },
        { "value": "theme", "label": "Theme font" }
      ],
      "default": "playfair"
    },
    {
      "type": "checkbox",
      "id": "load_fonts",
      "label": "Load the webfonts",
      "info": "Turn off if the theme already self-hosts them.",
      "default": true
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "richtext",
      "id": "decal",
      "label": "Line on the glass",
      "default": "<p>jewellery from the future. small runs, shipped worldwide. no restocks.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Discover collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Camera rail"
    },
    {
      "type": "text",
      "id": "hud_left",
      "label": "Left",
      "default": "Cam 01 — floor"
    },
    {
      "type": "text",
      "id": "hud_middle",
      "label": "Middle",
      "info": "Desktop only.",
      "default": "EW-001 // LAT 19.99 / LON 73.78"
    },
    {
      "type": "header",
      "content": "The room"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "medium", "label": "Medium" },
        { "value": "tall", "label": "Full screen" }
      ],
      "default": "tall"
    },
    {
      "type": "checkbox",
      "id": "show_table",
      "label": "Blue display table",
      "default": true
    },
    {
      "type": "text",
      "id": "table_plate",
      "label": "Etched on the vitrine",
      "default": "Drop 001 — 50 made"
    },
    {
      "type": "checkbox",
      "id": "show_globe",
      "label": "Globe on the table",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "globe_image",
      "label": "Globe artwork",
      "info": "Optional. Replaces the drawn globe — use a transparent PNG or SVG of the mark."
    },
    {
      "type": "checkbox",
      "id": "show_flicker",
      "label": "One failing tube",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dust",
      "label": "Dust in the light",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mullions",
      "label": "Window frame",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sheen",
      "label": "Reflection on the glass",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Film grain",
      "default": true
    },
    {
      "type": "header",
      "content": "Ticker"
    },
    {
      "type": "checkbox",
      "id": "show_ticker",
      "label": "Show ticker",
      "default": true
    },
    {
      "type": "text",
      "id": "ticker",
      "label": "Ticker items",
      "info": "Separate with commas.",
      "default": "Priority — cool shit, 50 made, 0 restocks, 0 ads ever, shipped worldwide obviously"
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "label": "Ticker duration",
      "min": 20,
      "max": 90,
      "step": 2,
      "unit": "s",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Display case",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Necklaces"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "piece",
          "label": "Piece on display",
          "options": [
            { "value": "necklace", "label": "Necklace" },
            { "value": "ear-cuff", "label": "Ear cuff" },
            { "value": "ring", "label": "Ring" },
            { "value": "bracelet", "label": "Bracelet" },
            { "value": "earring", "label": "Earring" },
            { "value": "charm", "label": "Charm" }
          ],
          "default": "necklace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Encore storefront hero",
      "blocks": [
        { "type": "category", "settings": { "label": "Necklaces", "piece": "necklace" } },
        { "type": "category", "settings": { "label": "Ear cuffs", "piece": "ear-cuff" } },
        { "type": "category", "settings": { "label": "Rings", "piece": "ring" } },
        { "type": "category", "settings": { "label": "Bracelets", "piece": "bracelet" } },
        { "type": "category", "settings": { "label": "Earrings", "piece": "earring" } },
        { "type": "category", "settings": { "label": "Accessories", "piece": "charm" } }
      ]
    }
  ]
}
{% endschema %}
