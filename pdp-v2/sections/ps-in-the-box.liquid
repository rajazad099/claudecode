{%- comment -%}
  "In the box" strip for the product page. Each item is a block; images can be swapped in the editor,
  otherwise the matched studio shots shipped with the theme are used.
{%- endcomment -%}
{{ 'ps-pdp.css' | asset_url | stylesheet_tag }}
<section class="ps ps-box page-width" id="PsBox-{{ section.id }}">
  <div class="ps-box__head">
    <h2 class="ps-box__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="ps-box__sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <ul class="ps-box__grid" role="list">
    {%- for block in section.blocks -%}
      <li class="ps-box__item" {{ block.shopify_attributes }}>
        <div class="ps-box__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 30vw, 33vw', alt: block.settings.title }}
          {%- elsif block.settings.fallback != blank -%}
            <img src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="1200" height="1200">
          {%- endif -%}
        </div>
        <p class="ps-box__name">{{ block.settings.title }}</p>
        {%- if block.settings.text != blank -%}<p class="ps-box__text">{{ block.settings.text }}</p>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "PS: In the box",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "In the box" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Every pair ships with" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Built-in image file", "info": "Used when no image is picked: ps-box-giftbox.webp, ps-box-case.webp or ps-box-cloth.webp" },
        { "type": "text", "id": "title", "label": "Name", "default": "Item" },
        { "type": "text", "id": "text", "label": "Short line" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "PS: In the box",
      "blocks": [
        { "type": "item", "settings": { "fallback": "ps-box-giftbox.webp", "title": "Gift box", "text": "Ready to gift" } },
        { "type": "item", "settings": { "fallback": "ps-box-case.webp", "title": "Carry case", "text": "Snap-shut, slim" } },
        { "type": "item", "settings": { "fallback": "ps-box-cloth.webp", "title": "Microfiber cloth", "text": "Lens-safe cleaning" } }
      ]
    }
  ]
}
{% endschema %}
