{%- comment -%}
  Delivery-date check. Maths runs in ps-pdp.js in India time: dispatch at 10:00 on working days,
  no Sunday/holiday dispatch, no Sunday delivery, always a date range.
  Transit table: shop metafield ps_ops.delivery (measured from delivered orders); the script has a fallback.
  Product page only: the script never touches the cart.
{%- endcomment -%}
<div class="ps ps-ship" {{ block.shopify_attributes }} data-ps-ship data-holidays="{{ block.settings.holidays | newline_to_br | strip_newlines | replace: '<br />', ',' | escape }}">
  {%- if shop.metafields.ps_ops.delivery != blank -%}
    <script type="application/json" data-ps-delivery>{{ shop.metafields.ps_ops.delivery.value | json }}</script>
  {%- endif -%}
  <form class="ps-ship__pin" data-ps-pin novalidate>
    <label class="visually-hidden" for="PsPin-{{ block.id }}">Pincode</label>
    <input id="PsPin-{{ block.id }}" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="Enter pincode" autocomplete="postal-code">
    <button type="submit">Check</button>
  </form>
  <p class="ps-ship__eta">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
    <span data-ps-eta>Enter your pincode to check estimated delivery</span>
  </p>
</div>
