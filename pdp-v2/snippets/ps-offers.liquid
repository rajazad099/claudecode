{%- comment -%}
  Offers: mix-and-match bundle tiers + prepaid free shipping. Discounts apply automatically at checkout;
  this block only states them.
{%- endcomment -%}
{%- liquid
  assign q1 = block.settings.tier1_qty | default: 2
  assign q2 = block.settings.tier2_qty | default: 3
  assign p1 = block.settings.tier1_pct | default: 10
  assign p2 = block.settings.tier2_pct | default: 15
-%}
<div class="ps ps-offers" {{ block.shopify_attributes }}>
  <div class="ps-offers__tiers">
    <p class="ps-offers__tier"><b>{{ p1 }}% off</b><span>any {{ q1 }} pairs</span></p>
    <p class="ps-offers__tier"><b>{{ p2 }}% off</b><span>any {{ q2 }} pairs</span></p>
  </div>
  {%- if block.settings.show_shipping -%}
    <p class="ps-offers__ship">{{ block.settings.heading | default: 'Mix & match' }} · {{ block.settings.ship_title | default: 'Free shipping on prepaid orders' }}</p>
  {%- endif -%}
</div>
