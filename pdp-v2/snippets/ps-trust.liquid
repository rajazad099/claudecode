{%- comment -%}
  Trust line: four short promises. The returns item links to the refund policy. Products in the
  custom-lenses collection also get a one-line note on made-to-order lens returns.
{%- endcomment -%}
{%- assign ps_policy_url = routes.root_url | append: '/policies/refund-policy' | replace: '//', '/' -%}
{%- assign ps_lens = false -%}
{%- for c in product.collections -%}{%- if c.handle == 'custom-lenses' -%}{%- assign ps_lens = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
<ul class="ps ps-trust" {{ block.shopify_attributes }}>
  <li>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c.6-3 2.9-4.8 5.5-4.8s4.9 1.8 5.5 4.8"/><path d="M15.5 5.2a3.2 3.2 0 0 1 0 5.6M17.5 14.6c1.6.6 2.7 2.2 3 4.4"/></svg>
    <span><b>{{ block.settings.t1 }}</b>{% if block.settings.s1 != blank %}<small>{{ block.settings.s1 }}</small>{% endif %}</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
    <span><b>{{ block.settings.t2 }}</b>{% if block.settings.s2 != blank %}<small>{{ block.settings.s2 }}</small>{% endif %}</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3.6"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/></svg>
    <span><b>{{ block.settings.t3 }}</b>{% if block.settings.s3 != blank %}<small>{{ block.settings.s3 }}</small>{% endif %}</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 7 5 11l4 4"/><path d="M5 11h9a5 5 0 0 1 0 10h-2"/></svg>
    <a class="ps-trust__link" href="{{ ps_policy_url }}"><b>{{ block.settings.t4 }}</b>{% if block.settings.s4 != blank %}<small>{{ block.settings.s4 }}</small>{% endif %}</a>
  </li>
</ul>
{%- if ps_lens -%}
  <p class="ps ps-lensnote">Customised lenses are made to order: ships in 3 working days, prepaid only, and returnable only if damaged or incorrect. <a href="{{ ps_policy_url }}">Return policy</a></p>
{%- endif -%}
