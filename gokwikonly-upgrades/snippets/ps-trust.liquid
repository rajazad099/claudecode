{%- comment -%} 2x2 trust grid. Titles and lines come from the block settings. {%- endcomment -%}
<div class="ps ps-trust" {{ block.shopify_attributes }}>
  {%- liquid
    assign icons = 'people,clock,sun,return' | split: ','
  -%}
  {%- for i in (1..4) -%}
    {%- assign tkey = 'title_' | append: i -%}
    {%- assign skey = 'sub_' | append: i -%}
    {%- if block.settings[tkey] != blank -%}
      <div class="ps-trust__item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {%- case icons[forloop.index0] -%}
            {%- when 'people' -%}<circle cx="9" cy="8" r="3.2"/><path d="M3 20c.8-3.6 3.2-5.5 6-5.5s5.2 1.9 6 5.5"/><path d="M16 4.8a3.2 3.2 0 0 1 0 6.4M18 14.8c1.6.7 2.6 2.4 3 5.2"/>
            {%- when 'clock' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
            {%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
            {%- when 'return' -%}<path d="M9 14L4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/>
          {%- endcase -%}
        </svg>
        <span><span class="ps-trust__t">{{ block.settings[tkey] }}</span><span class="ps-trust__s">{{ block.settings[skey] }}</span></span>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>
