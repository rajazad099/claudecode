    "collapsible_content_ibVtmy": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_tTALcV": {
          "type": "collapsible_row",
          "settings": {
            "title": "Are these sunglasses UV protected?",
            "content": "<p>Yes. Every pair offers UV400 protection — meaning 100% shield from UVA & UVB rays.</p>"
          }
        },
        "collapsible_row_qDpVAE": {
          "type": "collapsible_row",
          "settings": {
            "title": "How long will my order take to arrive?",
            "content": "<p>3–7 working days in India. We ship all orders next day, except Sundays. Tentative delivery timeline once shipped for Mumbai & Pune : 2 days, Delhi & Ahmedabad 3-4 days, Bangalore & Hyderabad 4-5 days.</p>"
          }
        },
        "collapsible_row_fLH68E": {
          "type": "collapsible_row",
          "settings": {
            "title": "How can I track my order?",
            "content": "<p>Once shipped, you’ll receive a tracking link via email and WhatsApp. You can also check status anytime on our website.</p>"
          }
        },
        "collapsible_row_YVB8Pw": {
          "type": "collapsible_row",
          "settings": {
            "title": "Can I change my order after placing it?",
            "content": "<p>Only if it hasn’t shipped. We move fast — like your new shades will. reach out on support@projectshades.com, whatsapp : +91 7558544365 or DM @project.shades.</p>"
          }
        },
        "collapsible_row_FJQYUF": {
          "type": "collapsible_row",
          "settings": {
            "title": "What if my product arrives damaged or not as expected?",
            "content": "<p>Rare, but we’ve got you. <a href=\"https://returns.logisy.tech/returns?encipherencode=gAAAAABodNVtF_Ir8odNhpD6RRc9cqW00HTTYRbjMzR3BJDlSTh1oEY3zyQHpGyTR0lPl0fHtjxxWrFUT24j0rPNVbGCfQtQuA==\" title=\"https://returns.logisy.tech/returns?encipherencode=gAAAAABodNVtF_Ir8odNhpD6RRc9cqW00HTTYRbjMzR3BJDlSTh1oEY3zyQHpGyTR0lPl0fHtjxxWrFUT24j0rPNVbGCfQtQuA==\">Raise a return request</a> within 3 days of delivery. </p>"
          }
        }
      },
